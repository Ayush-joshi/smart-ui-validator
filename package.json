{
  "name": "smart-ui-validator-workspace",
  "version": "0.4.2",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.16"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils>undici": "7.29.0",
      "postcss>nanoid": "3.3.18"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run tests/e2e",
    "test:studio": "vitest run tests/studio-server.test.ts tests/studio-ui.test.ts",
    "test:mcp:stdio": "node scripts/check-mcp-stdio.mjs",
    "format:check": "prettier --check .",
    "evaluate": "node scripts/run-evaluation.mjs",
    "evaluate:svg": "node scripts/run-svg-generation-evaluation.mjs",
    "evaluate:svg:measure": "node scripts/measure-svg-generation-corpus.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "privacy:check": "node scripts/check-personal-data.mjs",
    "package:check": "node scripts/check-package.mjs",
    "consumer:check": "node scripts/check-clean-consumer.mjs",
    "publish:check": "node scripts/check-publish-readiness.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "fixture:dev": "pnpm --filter @smart-ui/react-fixture dev",
    "fixture:angular:dev": "pnpm --filter @smart-ui/angular-fixture dev",
    "workflow:setup": "node scripts/setup-workflow.mjs",
    "smart-ui": "pnpm --filter smart-ui-validator start",
    "smart-ui-mcp": "node apps/mcp-server/dist/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@eslint/js": "9.34.0",
    "@types/node": "22.18.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "playwright": "1.55.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
