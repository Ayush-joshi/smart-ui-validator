{
  "name": "smart-ui-validator-mcp",
  "version": "0.4.1",
  "license": "MIT",
  "description": "Approval-gated stdio MCP server for Smart UI inspection, deterministic validation, bounded repair, reports, and governed memory.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ui-validation",
    "visual-regression",
    "playwright",
    "figma"
  ],
  "homepage": "https://www.npmjs.com/package/smart-ui-validator-mcp",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "type": "module",
  "bin": {
    "smart-ui-mcp": "dist/index.js",
    "smart-ui-validator-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "smart-ui-validator-core": "workspace:*",
    "zod": "4.1.5"
  }
}
