{
  "name": "smart-ui-validator",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Command-line interface for deterministic Smart UI inspection, validation, repair, reporting, and governed memory.",
  "keywords": [
    "ui-validation",
    "visual-regression",
    "cli",
    "playwright",
    "react",
    "angular"
  ],
  "homepage": "https://www.npmjs.com/package/smart-ui-validator",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "bin": {
    "smart-ui": "dist/index.js",
    "smart-ui-validator": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "smart-ui-validator-core": "workspace:*",
    "commander": "14.0.0"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
