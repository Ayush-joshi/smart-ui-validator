{
  "name": "@smart-ui/core",
  "version": "0.4.0",
  "description": "Host-neutral deterministic UI validation, browser evidence, bounded repair, policy, and governed-memory engine.",
  "keywords": [
    "ui-validation",
    "visual-regression",
    "playwright",
    "react",
    "angular",
    "mcp"
  ],
  "homepage": "https://github.com/Ayush-joshi/smart-ui-validator#readme",
  "bugs": {
    "url": "https://github.com/Ayush-joshi/smart-ui-validator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayush-joshi/smart-ui-validator.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "agent-memory": "github:Ayush-joshi/agent-memory#da87697",
    "playwright": "1.55.1",
    "zod": "4.1.5"
  }
}
