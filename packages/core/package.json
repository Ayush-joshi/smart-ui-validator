{
  "name": "smart-ui-validator-core",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Host-neutral engine for deterministic UI generation, validation, bounded implementation handoff, policy, and governed memory.",
  "keywords": [
    "ui-validation",
    "visual-regression",
    "playwright",
    "react",
    "angular",
    "mcp"
  ],
  "homepage": "https://www.npmjs.com/package/smart-ui-validator-core",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dev-agent-memory": "0.4.1",
    "parse5": "8.0.0",
    "playwright": "1.55.1",
    "postcss": "8.5.25",
    "saxes": "6.0.0",
    "zod": "4.1.5"
  }
}
